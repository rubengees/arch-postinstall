[Unit]
Description=OpenCode
Documentation=https://opencode.ai
After=network.target

[Service]
Type=simple
ExecStart=opencode serve --port 4096
Restart=on-failure
RestartSec=5s

# Redirect logs to the journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=opencode

[Install]
WantedBy=default.target